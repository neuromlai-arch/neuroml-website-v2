# Copy to .env and fill in. Never commit the real .env.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Matches docker-compose.yml's db service.
DATABASE_URL=postgres://site_backend:site_backend@localhost:5432/site_backend

# Used by the bootstrap_superuser management command.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

# Only required when DJANGO_SETTINGS_MODULE=config.settings.prod
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
