# Copy to .env and fill in. Never commit the real .env.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Matches docker-compose.yml's db service.
DATABASE_URL=postgres://site_backend:site_backend@localhost:5432/site_backend

# Used by the bootstrap_superuser management command.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

# From address for every notification email (form submissions, newsletter
# confirmations). Delivered async via django-q2 — see Q_CLUSTER in
# config/settings/base.py. Run `python manage.py qcluster` locally to
# actually send queued mail instead of leaving it queued.
DJANGO_DEFAULT_FROM_EMAIL=no-reply@example.com

# Only required when DJANGO_SETTINGS_MODULE=config.settings.prod
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# SMTP relay for outbound notification/confirmation emails. Only required
# when DJANGO_SETTINGS_MODULE=config.settings.prod — dev uses the console
# backend instead. EMAIL_HOST is required; the rest have defaults.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
