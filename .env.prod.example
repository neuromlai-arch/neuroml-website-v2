# Production environment template. Copy to .env.prod on the server and fill
# in real values — never commit the filled-in file. See DEPLOY.md for the
# full breakdown of what each variable gates and what breaks without it.

# Must be config.settings.prod for a real deploy — config.settings.dev is
# local-only (DEBUG=True, console email, filesystem media) and must never
# run against real traffic or real user data.
DJANGO_SETTINGS_MODULE=config.settings.prod

# Required. Generate a long random value and never reuse the dev one —
# sessions, password resets, and every signed token (preview links, gated
# downloads, newsletter confirmation) derive from this key.
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Comma-separated, no spaces, no scheme/port — just the host(s) this
# deploy answers to. With DEBUG=False an empty list means every request
# 400s (CommonMiddleware can't validate Host).
DJANGO_ALLOWED_HOSTS=neuroml.ai,www.neuroml.ai

# postgres://user:password@host:port/dbname — the deploy's db service in
# deploy/docker-compose.prod.yml, or a managed Postgres instance's connection
# string. Required; nothing works without it.
DATABASE_URL=

# S3 bucket for uploaded media (case study images, resumes, handbook PDFs,
# etc). Static files are served by whitenoise instead, not from this bucket.
# The bucket, and an IAM user/role scoped to read+write on it, must exist
# before first deploy — see the cutover checklist in DEPLOY.md.
AWS_STORAGE_BUCKET_NAME=neuroml-media
# AWS region the bucket above lives in, e.g. us-east-1. django-storages
# derives the actual AWS endpoint from this — no AWS_S3_ENDPOINT_URL needed
# unless you're pointing at an S3-compatible provider that isn't AWS itself.
AWS_S3_REGION_NAME=
# Credentials for the IAM user/role with access to the bucket above. Prefer
# a dedicated IAM user scoped to only this bucket over reusing root/admin
# account keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# SMTP relay for outbound notification/confirmation email (contact/demo/popup
# submissions, handbook-gate, job applications, newsletter confirmation) —
# sent async by the qcluster worker, not the web process. Postmark and SES
# both work as a plain SMTP relay; use the relay's SMTP hostname here, not
# an API endpoint.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Grounded chat widget (chat app). Leave unset to ship without the chat
# launcher rendering at all — that's a supported, fully working state, not
# a degraded one. Set only once you actually want the widget live.
ANTHROPIC_API_KEY=

# Read once, by `manage.py bootstrap_superuser` (run it via deploy/deploy.sh
# on first deploy) — not read anywhere else at runtime. Rotate/remove the
# password value from this file after the first successful run if it's
# ever going to sit on disk longer than that.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
